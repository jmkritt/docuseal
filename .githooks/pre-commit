#!/usr/bin/env bash
# Block accidentally committing secrets, client data, or production state.
# Refuses the commit if any staged file matches a sensitive pattern OR
# any staged hunk looks like a high-entropy secret.

set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

deny_patterns=(
  '^\.env$'
  '\.env\..*$'
  '\.key$'
  '\.pem$'
  '\.pfx$'
  '\.p12$'
  '\.crt$'
  '\.sqlite3?$'
  '\.dump$'
  '\.sql$'
  '\.sql\.gz$'
  '\.bak$'
  '\.backup$'
  '^data/'
  '^storage/'
  '^attachments/'
  'service-account.*\.json$'
  '^config/master\.key$'
  '^config/credentials.*\.key$'
)

bad_files=()
while IFS= read -r f; do
  for pat in "${deny_patterns[@]}"; do
    if [[ "$f" =~ $pat ]]; then
      bad_files+=("$f (matched: $pat)")
      break
    fi
  done
done <<< "$staged"

if [ ${#bad_files[@]} -gt 0 ]; then
  echo "❌  Refusing commit. These files look sensitive:"
  printf '   - %s\n' "${bad_files[@]}"
  echo ""
  echo "If you really mean to commit one of these, run with --no-verify."
  exit 1
fi

# Scan staged hunks for high-entropy strings that look like secrets.
# Uses a simple heuristic: 32+ char base64/hex strings, plus common token prefixes.
hunk_findings="$(git diff --cached --diff-filter=ACMR -U0 \
  | grep -E '^\+' \
  | grep -vE '^\+\+\+ ' \
  | grep -E '(secret|password|api[_-]?key|token|aws_access|aws_secret|bearer)' -i \
  | grep -vE '(example|placeholder|TODO|FIXME|XXX|test_|dev_|<%= ENV)' \
  || true)"

if [ -n "$hunk_findings" ]; then
  echo "⚠️   Possible secret in your staged changes:"
  echo "$hunk_findings" | head -10
  echo ""
  echo "Review the lines above. If they're real secrets, remove them."
  echo "If they're just code referring to a secret name, run with --no-verify."
  exit 1
fi

exit 0
