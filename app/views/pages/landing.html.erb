<style>
  body { background-color: #0A0A0A; }
  /* Hide DocuSeal navbar on landing — full Kritt branding */
  body > .max-w-6xl:first-of-type,
  body > div:has(> a[href$='/']) { display: none; }
  /* Hide DocuSeal app outer wrapper margins so our section fills */
  body > div.max-w-6xl.mb-8 { max-width: none !important; padding: 0 !important; margin: 0 !important; }
</style>

<section style="background-color: #0A0A0A; min-height: 100vh; color: #FAFAFA;" class="flex items-start md:items-center justify-center -mt-8 -mx-4 md:-mx-2">
  <div class="py-16 md:py-24 mx-auto max-w-3xl px-6 w-full">
    <div class="text-center">
      <div class="flex flex-col items-center">
        <img src="/kritt-logo.webp" alt="Kritt Real Estate" class="w-44 md:w-56 h-auto mb-8">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight" style="color: #FAFAFA;">
          KrittSign
        </h1>
        <div class="mt-3 flex items-center gap-3">
          <span class="block w-12 h-[2px]" style="background-color: #D4A84B;"></span>
          <span class="text-sm uppercase tracking-widest" style="color: #D4A84B;">Document Signing</span>
          <span class="block w-12 h-[2px]" style="background-color: #D4A84B;"></span>
        </div>
      </div>
      <p class="mt-10 text-lg leading-relaxed" style="color: #E5E5E5;">
        Secure, legally-binding electronic signing for Kritt Real Estate clients. If you've been invited to sign a document, please check your email for a personalized signing link.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      <div class="card border" style="background-color: #1C1C1C; border-color: rgba(212, 168, 75, 0.3);">
        <div class="card-body text-center">
          <h3 class="text-xl font-semibold mb-2" style="color: #FAFAFA;">Have a signing link?</h3>
          <p class="text-base" style="color: #BFBFBF;">
            Look in your email inbox for a message from <strong style="color: #FAFAFA;">jeremy@krittrealestate.com</strong>. Click the link in that email to begin signing your document.
          </p>
        </div>
      </div>

      <div class="card border" style="background-color: #1C1C1C; border-color: rgba(212, 168, 75, 0.3);">
        <div class="card-body text-center">
          <h3 class="text-xl font-semibold mb-2" style="color: #FAFAFA;">Need to reach Jeremy?</h3>
          <p class="text-base" style="color: #BFBFBF;">
            <a href="mailto:jeremy@krittrealestate.com" style="color: #D4A84B;">jeremy@krittrealestate.com</a><br>
            <a href="tel:+15126863076" style="color: #D4A84B;">(512) 686-3076</a><br>
            <a href="https://krittrealestate.com" style="color: #D4A84B;">krittrealestate.com</a>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-14 text-center">
      <%= link_to new_user_session_path, class: 'btn btn-sm', style: 'background-color: #D4A84B; color: #0A0A0A; border-color: #D4A84B;' do %>
        Admin Sign In
      <% end %>
    </div>

    <div class="mt-12 text-center text-xs" style="color: #6B6B6B;">
      <p>
        KrittSign — built on
        <a href="https://github.com/docusealco/docuseal" style="color: #9A9A9A;" target="_blank" rel="noopener">DocuSeal</a>
        (open source under
        <a href="https://www.gnu.org/licenses/agpl-3.0.html" style="color: #9A9A9A;" target="_blank" rel="noopener">AGPL-3.0</a>).
      </p>
    </div>
  </div>
</section>
